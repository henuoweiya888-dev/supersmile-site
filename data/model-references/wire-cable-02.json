  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Interface & Application",
        "zh": "接口与应用"
      },
      "copy": {
        "en": "Internal wiring, AWM, flexible cord and the completed appliance have different specification and approval boundaries. The exact construction and use conditions must be identified.",
        "zh": "内部配线、AWM、柔性软线与完整电器具有不同规范和批准边界，必须明确准确结构与使用条件。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Provide the destination market, appliance zone map, circuit loads, temperatures, exposure, movement, wire or cord designation, terminal system and validation plan.",
        "zh": "请提供目标市场、电器分区图、回路负载、温度、环境暴露、运动状态、线材或软线型号、端子系统与验证方案。"
      }
    },
    {
      "title": {
        "en": "Release Requirements",
        "zh": "放行要求"
      },
      "copy": {
        "en": "Release records the exact wire or cord, conductor and insulation construction, marking, termination, routing, protection, traceability and agreed assembly checks.",
        "zh": "放行文件记录准确线材或软线、导体与绝缘结构、印字、端接、布线、防护、追溯及约定组件检查。"
      }
    },
    {
      "title": {
        "en": "Mating & Termination",
        "zh": "对插与端接"
      },
      "copy": {
        "en": "Identify the mating part number and termination method before confirming the assembly drawing.",
        "zh": "确认对插件料号和端接方式，再确定组件图纸。"
      }
    },
    {
      "title": {
        "en": "Sample Review",
        "zh": "样品审核"
      },
      "copy": {
        "en": "Compare the sample with the approved pin map, dimensions and material list.",
        "zh": "按确认的针脚对应、尺寸和材料清单审核样品。"
      }
    },
    {
      "title": {
        "en": "Build Records",
        "zh": "制造记录"
      },
      "copy": {
        "en": "Retain the approved part list and inspection results for repeat production.",
        "zh": "保留确认物料清单与检验结果，作为重复生产依据。"
      }
    }
  ],
