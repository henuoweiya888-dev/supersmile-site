  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "An engine harness is a coordinated power, signal, communication and mechanical routing system, not a bundle copied from connector appearance. Engine family, controller, sensor and actuator set, firing order, transmission, emissions equipment, system voltage, thermal map, vibration, fluids, service route and vehicle interface determine the released design.",
        "zh": "发动机线束是一套协调供电、信号、通信与机械走线的系统，不能依据连接器外观简单复制。发动机家族、控制器、传感器与执行器组合、点火顺序、变速箱、排放设备、系统电压、热分布、振动、油液、维修路径和整车接口共同决定放行设计。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Provide engine and vehicle or equipment identity; controller and calibration family; system voltage; connector and mating-part data; pin and circuit tables; sensor, injector, ignition, valve, motor and heater loads; CAN, LIN or other communication details; grounding and shielding intent; on-engine and body-side breakpoints; route photographs and datums; heat, vibration, oil, fuel, coolant, water and abrasion exposure; drawings or sample; labels;",
        "zh": "请提供发动机及车辆或设备身份、控制器与标定家族、系统电压、连接器及对插件资料、针脚与回路表、传感器、喷油器、点火、阀、电机与加热器负载、CAN、LIN 或其他通信信息、接地与屏蔽意图、发动机本体和车身侧断开点、走线照片与基准、热、振动、机油、燃油、冷却液、水与磨损暴露、图纸或样品、标签、数量及所需验证。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Approved requirements become controlled drawings, pin and circuit tables, BOMs, cut lists, splice maps, branch datums, shielding and protection instructions, labels and test definitions. First articles are checked for mating, reach, clip position, engine installation, service access, electrical identity and agreed powered functions before repeat production.",
        "zh": "批准需求会转化为受控图纸、针脚与回路表、物料表、裁线表、接续图、分支基准、屏蔽与防护工艺、标签及测试定义。重复生产前检查首件的对插、可达、卡扣位置、发动机装配、维修空间、电气身份与约定上电功能；线束版本持续关联发动机、控制器、车辆配置、工装和检验记录。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
