  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "Fuel delivery architectures differ across port-injected gasoline, gasoline direct injection and diesel common rail. A matching connector body does not establish the correct pin map, injector driver, pump current, sensor reference or environmental rating. Define each circuit and its installed zone before choosing wire, terminals, sealing and branch protection.",
        "zh": "歧管喷射汽油机、汽油直喷和柴油共轨的供油电气架构并不相同。接头外壳能对插，不代表针脚表、喷油驱动、泵电流、传感器参考电压或环境等级正确。选择线材、端子、密封与分支防护前，先定义每条回路及其安装区域。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Send vehicle and engine identity, controller family, system voltage, pump and injector part numbers, mating connectors and cavity views, circuit and pin tables, sensor outputs, route dimensions, clips, heat and fuel exposure, sample or drawing, quantity and agreed inspection requirements.",
        "zh": "请提供车辆与发动机身份、控制器家族、系统电压、泵和喷油器料号、对插件与孔位视图、回路及针脚表、传感器输出形式、走线尺寸、卡扣、热与燃油暴露条件、样品或图纸、数量和约定检验要求。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Approved inputs become controlled drawings, a pin and circuit map, BOM, branch datums, termination and protection instructions, labels and inspection criteria. A first article is reviewed for mating, reach, routing and electrical identity before repeat build; powered function, ingress, thermal and chemical tests require separately agreed methods and limits.",
        "zh": "批准的输入转化为受控图纸、针脚与回路图、物料表、分支基准、端接和防护工艺、标签及检验准则。重复制作前，首件核对对插、可达、走线和电气身份；上电功能、防护、热与化学测试须另行约定方法和限值。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
