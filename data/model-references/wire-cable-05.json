  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "System impedance, frequency, loss, power, cable construction, connector interface, termination and validation must be defined together.",
        "zh": "系统阻抗、频率、损耗、功率、线缆结构、连接器界面、端接与验证必须共同定义。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Provide equipment ports, impedance, frequency band, signal or power, length, cable limits, route, environment and test evidence.",
        "zh": "请提供设备端口、阻抗、频段、信号或功率、长度、线缆限制、路径、环境与测试证据。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Release records cable and connector part numbers, impedance, length, strip and termination controls, labels, environment and agreed electrical evidence.",
        "zh": "放行记录包含线缆与连接器料号、阻抗、长度、剥线和端接控制、标签、环境及约定电气证据。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
