  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Finished cable and harness references for this interface or application.",
        "zh": "此接口或应用方向的成品电缆与线束参考。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Connector, wire and process-material references for project selection.",
        "zh": "供项目选型的连接器、线材与工艺材料参考。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "PV connector system",
        "zh": "光伏连接器体系"
      },
      "copy": {
        "en": "Confirm both mating connector part numbers and the manufacturer’s permitted mating combinations.",
        "zh": "确认双方对配连接器料号及厂家允许的配对组合。"
      }
    },
    {
      "title": {
        "en": "Cable and conductor size",
        "zh": "线材与截面积"
      },
      "copy": {
        "en": "Specify PV cable grade, conductor section, outer diameter and the required system voltage and current.",
        "zh": "明确光伏线牌号、截面积、外径及系统电压电流。"
      }
    },
    {
      "title": {
        "en": "Crimp and sealing range",
        "zh": "压接与密封范围"
      },
      "copy": {
        "en": "Match terminals, crimp tooling and seals to the actual cable dimensions.",
        "zh": "按真实线缆尺寸匹配端子、压接工装与密封件。"
      }
    },
    {
      "title": {
        "en": "Outdoor route",
        "zh": "户外走线"
      },
      "copy": {
        "en": "Review sunlight, water, temperature, cable support and abrasion in the intended installation.",
        "zh": "结合安装位置审核日照、水、温度、线缆固定及磨损。"
      }
    },
    {
      "title": {
        "en": "Polarity and branching",
        "zh": "极性与分支"
      },
      "copy": {
        "en": "Define positive/negative identification, extension direction and any branch or splitter topology.",
        "zh": "定义正负极识别、延长方向及分支或分流器拓扑。"
      }
    },
    {
      "title": {
        "en": "Assembly inspection",
        "zh": "组件检验"
      },
      "copy": {
        "en": "Agree polarity, continuity, crimp and sealing checks for the completed solar cable assembly.",
        "zh": "约定太阳能成品线的极性、导通、压接及密封检验。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
