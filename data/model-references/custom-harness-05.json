  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Heater and cabinet temperature zones",
        "zh": "加热区与机内温区"
      },
      "copy": {
        "en": "Locate heater bodies, compressor surfaces and restricted ventilation before choosing insulation and sleeving. Review the actual local wire temperature rather than the appliance room temperature alone.",
        "zh": "选择绝缘与套管前先标出加热体、压缩机表面及通风受限区域，审核导线所在位置的实际温度，不能只参考设备外部环境温度。"
      }
    },
    {
      "title": {
        "en": "Power, motor and sensor branches",
        "zh": "供电、电机与传感分支"
      },
      "copy": {
        "en": "Separate the current and termination requirements of heaters, motors and control sensors. Record startup loads and branch lengths before selecting conductor sizes.",
        "zh": "分别确认加热器、电机与控制传感器的电流及端接要求，选择导体规格前记录启动负载和各分支长度。"
      }
    },
    {
      "title": {
        "en": "Board revision and appliance variant",
        "zh": "控制板版本与设备变型"
      },
      "copy": {
        "en": "Use the appliance variant, board revision and connector cavity map to identify the harness. A matching connector shape or appliance family name does not establish the same circuit.",
        "zh": "依据设备变型、控制板版本和接口孔位表识别线束；接口外形相同或属于同一设备系列，并不能证明回路一致。"
      }
    },
    {
      "title": {
        "en": "Edges, clips and moving parts",
        "zh": "锐边、卡扣与运动部件"
      },
      "copy": {
        "en": "Place grommets and fixing clips at sheet-metal entries, fan zones and moving assemblies. Check the assembly path so a finished connector is not forced through an undersized opening.",
        "zh": "在钣金入口、风扇区域和运动组件附近安排护线圈与固定卡扣，并核对装配路径，避免已端接接口被迫穿过尺寸不足的开口。"
      }
    },
    {
      "title": {
        "en": "Branch order and service access",
        "zh": "分支顺序与维修可达性"
      },
      "copy": {
        "en": "Set branch order around the production sequence and removable appliance panels. Labels and connector orientation should let a service technician replace a branch without disturbing unrelated wiring.",
        "zh": "围绕生产装配顺序及可拆面板安排分支，标签与接口方向应便于维修人员更换局部分支，减少对其他布线的扰动。"
      }
    },
    {
      "title": {
        "en": "Sample and electrical acceptance",
        "zh": "样品与电气验收"
      },
      "copy": {
        "en": "Agree pin mapping, continuity, terminal retention, routing and the project-specific electrical inspection plan. Record the approved appliance variant and drawing revision with the sample.",
        "zh": "约定针脚对应、导通、端子保持、布线以及项目适用的电气检验计划，并与样品一起记录已确认的设备变型和图纸版本。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
