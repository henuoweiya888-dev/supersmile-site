  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Panel geometry",
        "zh": "面板几何形状"
      },
      "copy": {
        "en": "Provide panel thickness, cutout, mounting side and the available interior space.",
        "zh": "提供板厚、开孔、安装侧及内部可用空间。"
      }
    },
    {
      "title": {
        "en": "Interface and retention",
        "zh": "接口与保持"
      },
      "copy": {
        "en": "Specify connector part number, keying, thread or fastener and required mating access.",
        "zh": "明确接口料号、防呆、螺纹或紧固件及对插操作空间。"
      }
    },
    {
      "title": {
        "en": "Cable transition",
        "zh": "线缆过渡"
      },
      "copy": {
        "en": "Choose wire leads, an internal cable or a board interface according to the equipment layout.",
        "zh": "按设备布局选择引线、内部电缆或板端接口。"
      }
    },
    {
      "title": {
        "en": "Edge and strain protection",
        "zh": "边缘与应力防护"
      },
      "copy": {
        "en": "Match grommets, edge protection and cord grips to the panel and actual cable diameter.",
        "zh": "按面板和真实线缆外径匹配护线圈、边缘保护及线夹。"
      }
    },
    {
      "title": {
        "en": "Seal and shield boundary",
        "zh": "密封与屏蔽边界"
      },
      "copy": {
        "en": "Define sealing faces, gasket compression and any chassis-to-shield bond.",
        "zh": "定义密封面、垫片压缩及机壳到屏蔽层的搭接。"
      }
    },
    {
      "title": {
        "en": "Installed verification",
        "zh": "安装验证"
      },
      "copy": {
        "en": "Verify fit, retention and electrical function in a representative panel fixture.",
        "zh": "在代表性面板工装上验证配合、保持力及电气功能。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
