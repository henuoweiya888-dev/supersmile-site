{
  "version": 2,
  "category_id": "specialty-01",
  "route": "/products/32awg-fine-pitch-harness",
  "title": {
    "en": "Models, Part Numbers & Sourcing",
    "zh": "型号料号与定制采购"
  },
  "kicker": {
    "en": "PART NUMBER / INTERFACE / MATERIAL",
    "zh": "型号 / 接口 / 材料"
  },
  "intro": {
    "en": "Find a cable model or material part number, then send it for a custom replacement or original-part sourcing review.",
    "zh": "按成品型号或材料料号查找，提交编号即可沟通兼容替代件制作或原厂件采购。"
  },
  "jump": {
    "en": "Find Models & Material Part Numbers",
    "zh": "查找型号与材料料号"
  },
  "search_label": {
    "en": "Find a model or part number",
    "zh": "查找型号或料号"
  },
  "search_placeholder": {
    "en": "Brand, model, part number or product type",
    "zh": "输入品牌、型号、料号或产品类型"
  },
  "clear": {
    "en": "Clear",
    "zh": "清空"
  },
  "empty": {
    "en": "No matching references. Try a brand, full part number or a listed alias.",
    "zh": "未找到匹配项，请尝试品牌、完整料号或已列出的别名。"
  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Fine-wire assemblies and 32AWG termination references; confirm wire gauge and interface for the exact part.",
        "zh": "细线组件与32AWG端接方案参考，线规和接口按具体料号核对。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "32AWG contacts and their matching housings and board connectors; confirm the complete wire and interface combination.",
        "zh": "含32AWG触点及其匹配壳体、针座，整套接口与线材组合按项目确认。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Fine-pitch mating pair",
        "zh": "细间距对配"
      },
      "copy": {
        "en": "Confirm pitch, row count, contact count, keying and the mating board connector drawing.",
        "zh": "确认间距、排数、针数、防呆及对配板端图纸。"
      }
    },
    {
      "title": {
        "en": "32AWG wire construction",
        "zh": "32AWG导体结构"
      },
      "copy": {
        "en": "Specify conductor strand construction, insulation and finished diameter rather than gauge alone.",
        "zh": "除线规外，明确导体绞合、绝缘及成品外径。"
      }
    },
    {
      "title": {
        "en": "Current and resistance",
        "zh": "电流与电阻"
      },
      "copy": {
        "en": "Check load and permitted resistance for the actual wire length and connector contact.",
        "zh": "按实际线长与连接器触点审核负载和允许电阻。"
      }
    },
    {
      "title": {
        "en": "Termination and handling",
        "zh": "端接与操作"
      },
      "copy": {
        "en": "Set strip length, termination tooling and handling controls appropriate to the small conductor.",
        "zh": "针对细导体设定剥线长度、端接工装及操作控制。"
      }
    },
    {
      "title": {
        "en": "Route and retention",
        "zh": "布线与保持"
      },
      "copy": {
        "en": "Provide bend clearance, support and connector retention so the lead does not carry equipment movement.",
        "zh": "提供弯曲空间、支撑和接口保持，避免设备运动直接拉扯导线。"
      }
    },
    {
      "title": {
        "en": "Small-wire verification",
        "zh": "细线检验"
      },
      "copy": {
        "en": "Agree continuity, pull-force and visual inspection criteria for the complete assembly.",
        "zh": "约定完整组件的导通、拉力与外观检验标准。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
      "en": "Discuss Custom Manufacturing & Sourcing",
      "zh": "咨询定制与采购"
    },
    "url": "/contact?category=specialty-01&source=part-number-review"
  },
