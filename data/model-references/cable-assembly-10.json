{
  "version": 2,
  "category_id": "cable-assembly-10",
  "route": "/products/lvds-cable-assembly",
  "title": {
    "en": "Models, Part Numbers & Sourcing",
    "zh": "型号料号与定制采购"
  },
  "kicker": {
    "en": "PART NUMBER / INTERFACE / MATERIAL",
    "zh": "型号 / 接口 / 材料"
  },
  "intro": {
    "en": "Find a cable model or material part number, then send it for a custom replacement or original-part sourcing review.",
    "zh": "按成品型号或材料料号查找，提交编号即可沟通兼容替代件制作或原厂件采购。"
  },
  "jump": {
    "en": "Find Models & Material Part Numbers",
    "zh": "查找型号与材料料号"
  },
  "search_label": {
    "en": "Find a model or part number",
    "zh": "查找型号或料号"
  },
  "search_placeholder": {
    "en": "Brand, model, part number or product type",
    "zh": "输入品牌、型号、料号或产品类型"
  },
  "clear": {
    "en": "Clear",
    "zh": "清空"
  },
  "empty": {
    "en": "No matching references. Try a brand, full part number or a listed alias.",
    "zh": "未找到匹配项，请尝试品牌、完整料号或已列出的别名。"
  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Finished cable and harness references for this interface or application.",
        "zh": "此接口或应用方向的成品电缆与线束参考。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Connector, wire and process-material references for project selection.",
        "zh": "供项目选型的连接器、线材与工艺材料参考。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Display and board identity",
        "zh": "屏与板身份"
      },
      "copy": {
        "en": "Confirm the exact display and controller connector drawings; display size does not specify cable length.",
        "zh": "确认显示屏与控制板的准确接口图；屏幕尺寸不能当作线长。"
      }
    },
    {
      "title": {
        "en": "Pin map and power pins",
        "zh": "针脚与电源脚"
      },
      "copy": {
        "en": "Define lane count, pair polarity, grounds, panel power and control pins from both device drawings.",
        "zh": "按两端设备图定义通道数、线对极性、地、电源及控制脚。"
      }
    },
    {
      "title": {
        "en": "Pair and impedance plan",
        "zh": "线对与阻抗方案"
      },
      "copy": {
        "en": "Review differential pairs, impedance and length matching for the intended link. A 90-ohm cable and a 100-ohm cable are distinct configurations.",
        "zh": "按目标链路审核差分线对、阻抗与等长要求；90Ω与100Ω线缆是不同配置。"
      }
    },
    {
      "title": {
        "en": "FFC or discrete cable",
        "zh": "FFC或离散线"
      },
      "copy": {
        "en": "Select FFC, micro-coax or twisted-pair construction from the interface and routing requirements.",
        "zh": "依据接口和布线要求选择FFC、微同轴或双绞结构。"
      }
    },
    {
      "title": {
        "en": "Fold and latch clearance",
        "zh": "折弯与锁扣空间"
      },
      "copy": {
        "en": "Define permitted folds, contact orientation, latch access and strain relief near the board.",
        "zh": "定义允许折弯、接点方向、锁扣操作及板端应力释放。"
      }
    },
    {
      "title": {
        "en": "Panel validation",
        "zh": "面板验证"
      },
      "copy": {
        "en": "Test startup, image stability and interference with the intended panel and controller pair.",
        "zh": "使用目标面板与控制器组合验证开机、画面稳定性及干扰。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
      "en": "Discuss Custom Manufacturing & Sourcing",
      "zh": "咨询定制与采购"
    },
    "url": "/contact?category=cable-assembly-10&source=part-number-review"
  },
  "source_label": {
    "en": "PDF datasheet",
    "zh": "PDF 规格书"
  },
  "alias_label": {
    "en": "Manufacturer type: ",
    "zh": "原厂型号："
  },
