  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "The visible display is only one endpoint of a vehicle electrical architecture. Power, grounds, illumination, CAN or LIN and sometimes other data links may reach the cluster through dedicated connectors; exact circuits vary by platform. A fit-matching shell does not prove correct signals, software configuration, warning telltales or safety function.",
        "zh": "可见的显示界面只是整车电气架构的一个端点。电源、接地、照明、CAN 或 LIN，以及其他数据链路可能通过专用接口到达组合仪表；具体回路随平台改变。壳体能对插，不证明信号、软件配置、警示灯或安全功能正确。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Send the vehicle/platform and model year, variant or trim, right- or left-hand-drive layout, circuit and cavity tables, mating connector part numbers, cluster and controller references, route drawings or sample, mounting clips, branch datums, expected quantities and agreed inspection points. Identify any SRS or other safety-critical interfaces separately.",
        "zh": "请提供车型平台与年款、配置变型、左右舵布局、回路与孔位表、对插件料号、仪表与控制器资料、走线图或样品、卡扣、分支基准、预计数量和约定检验项；涉及 SRS 等安全关键接口须单独标识。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Approved information becomes a controlled drawing, connector and pin matrix, BOM, branch geometry, labels and inspection plan. First-article review checks mating, reach, terminal seating, clip positions, clearance and circuit identity. Continuity or short testing does not certify the cluster's displayed functions, SRS performance or vehicle-level behavior; those need separate OEM-led validation.",
        "zh": "批准资料转化为受控图纸、连接器与针脚矩阵、物料表、分支几何、标签和检验计划。首件核对对插、可达、端子入位、卡扣位置、间隙及回路身份。导通或短路测试不代表仪表显示功能、SRS 性能或整车行为已验证；这些需要另行按整车方要求验证。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
