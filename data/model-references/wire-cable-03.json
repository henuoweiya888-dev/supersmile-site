  },
  "kicker": {
    "en": "PART NUMBER / INTERFACE / MATERIAL",
    "zh": "型号 / 接口 / 材料"
  },
  "intro": {
    "en": "Find a cable model or material part number, then send it for a custom replacement or original-part sourcing review.",
    "zh": "按成品型号或材料料号查找，提交编号即可沟通兼容替代件制作或原厂件采购。"
  },
  "jump": {
    "en": "Find Models & Material Part Numbers",
    "zh": "查找型号与材料料号"
  },
  "search_label": {
    "en": "Find a model or part number",
    "zh": "查找型号或料号"
  },
  "search_placeholder": {
    "en": "Brand, model, part number or product type",
    "zh": "输入品牌、型号、料号或产品类型"
  },
  "clear": {
    "en": "Clear",
    "zh": "清空"
  },
  "empty": {
    "en": "No matching references. Try a brand, full part number or a listed alias.",
    "zh": "未找到匹配项，请尝试品牌、完整料号或已列出的别名。"
  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Manufacturer-identified finished assemblies for this application.",
        "zh": "此应用范围内经原厂资料核验的成品组件。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Category-specific material references; the final BOM follows the approved configuration.",
        "zh": "此类选型的材料参考；最终 BOM 以确认配置为准。"
      }
    }
  ],
  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "MTW, AWM and field-installed wiring have different product and installation scopes; exact marking, location and governing standard must be reviewed.",
        "zh": "MTW、AWM 与现场敷设电线具有不同产品和安装范围，必须审核准确印字、位置与适用标准。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Provide the market, machine standard, circuit list, route map, exact wire designation, terminal system and validation plan.",
        "zh": "请提供目标市场、机器标准、回路表、路径图、准确线材型号、端接系统与验证方案。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Release records the wire identity, construction, cut and strip details, termination combination, routing, traceability and agreed checks.",
        "zh": "放行记录包含线材身份、结构、裁线剥线、端接组合、布线路径、追溯与约定检查。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
      "en": "Discuss Custom Manufacturing & Sourcing",
      "zh": "咨询定制与采购"
    },
    "url": "/contact?category=wire-cable-03&source=part-number-review"
  },
  "source_label": {
