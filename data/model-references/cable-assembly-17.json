  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Finished cable and harness references for this interface or application.",
        "zh": "此接口或应用方向的成品电缆与线束参考。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Connector, wire and process-material references for project selection.",
        "zh": "供项目选型的连接器、线材与工艺材料参考。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Power and data mix",
        "zh": "动力与数据组合"
      },
      "copy": {
        "en": "List power circuits, data protocols and any RF channels within the proposed hybrid assembly.",
        "zh": "列明复合组件中的动力回路、数据协议及射频通道。"
      }
    },
    {
      "title": {
        "en": "Interface allocation",
        "zh": "接口分配"
      },
      "copy": {
        "en": "Define insert layout, contact sizes, keying and separation of power and signal contacts.",
        "zh": "定义插芯布局、触点规格、防呆及动力与信号触点隔离。"
      }
    },
    {
      "title": {
        "en": "Thermal and signal design",
        "zh": "热与信号设计"
      },
      "copy": {
        "en": "Review current heating together with pair construction, shielding and the data-link requirements.",
        "zh": "结合载流温升、线对结构、屏蔽及数据链路要求审核设计。"
      }
    },
    {
      "title": {
        "en": "Shield and return paths",
        "zh": "屏蔽与回流路径"
      },
      "copy": {
        "en": "Agree chassis bonding, return conductors and screen termination at both ends.",
        "zh": "约定机壳搭接、回流导体及两端屏蔽端接。"
      }
    },
    {
      "title": {
        "en": "Mechanical integration",
        "zh": "机械集成"
      },
      "copy": {
        "en": "Confirm the shared jacket, branch geometry, bend clearance and connector exit in the enclosure.",
        "zh": "确认共用护套、分支几何形状、弯曲净空及机壳内出线。"
      }
    },
    {
      "title": {
        "en": "Combined verification",
        "zh": "组合验证"
      },
      "copy": {
        "en": "Validate power loading and data operation together in the actual system configuration.",
        "zh": "在实际系统配置中同时验证供电负载与数据工作。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
