  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Interference path",
        "zh": "干扰路径"
      },
      "copy": {
        "en": "Identify the relevant noise source, sensitive circuit and frequency range before selecting shielding.",
        "zh": "选择屏蔽前明确干扰源、敏感回路及频段。"
      }
    },
    {
      "title": {
        "en": "Cable screen construction",
        "zh": "线缆屏蔽结构"
      },
      "copy": {
        "en": "Select braid, foil, conductive sleeve or a combined screen with the required coverage and flexibility.",
        "zh": "按覆盖与柔性要求选择编织、箔、导电套管或组合屏蔽。"
      }
    },
    {
      "title": {
        "en": "Termination and bonding",
        "zh": "端接与搭接"
      },
      "copy": {
        "en": "Define how each screen connects to the connector shell or chassis at both ends.",
        "zh": "定义各屏蔽层在两端如何连接到接口外壳或机壳。"
      }
    },
    {
      "title": {
        "en": "Branch and enclosure gaps",
        "zh": "分支与机壳间隙"
      },
      "copy": {
        "en": "Review screen continuity at branches, service breaks and panel entries.",
        "zh": "审核分支、可拆连接及面板入口处的屏蔽连续性。"
      }
    },
    {
      "title": {
        "en": "Mechanical protection",
        "zh": "机械防护"
      },
      "copy": {
        "en": "Check sleeve diameter, bend radius, abrasion and strain relief with the finished harness.",
        "zh": "结合完整线束检查套管直径、弯曲半径、磨损及应力释放。"
      }
    },
    {
      "title": {
        "en": "System-level validation",
        "zh": "系统验证"
      },
      "copy": {
        "en": "Agree grounding and EMC test conditions on the target equipment; material shielding alone does not establish system performance.",
        "zh": "在目标设备上约定接地和EMC测试条件；屏蔽材料本身不能证明系统性能。"
      }
    }
  ],
