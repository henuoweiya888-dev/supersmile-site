  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Insert boundary",
        "zh": "嵌件与覆盖边界"
      },
      "copy": {
        "en": "Identify the bare insert, coverage boundary, connector openings and component keep-out zones before tool design.",
        "zh": "设计模具前明确裸嵌件、覆盖边界、接口开口和元件禁压区。"
      }
    },
    {
      "title": {
        "en": "Resin and substrates",
        "zh": "树脂与基材匹配"
      },
      "copy": {
        "en": "Compare the exact resin grade with the cable jacket, connector housing, PCB and other exposed substrates. Verify adhesion on the actual combination.",
        "zh": "结合线缆护套、连接器壳体、PCB及其他外露基材比较准确树脂牌号，并验证实际组合的附着。"
      }
    },
    {
      "title": {
        "en": "Thermal exposure",
        "zh": "控制成型热暴露"
      },
      "copy": {
        "en": "Separate resin application temperature from the assembly operating temperature. Review the heat and pressure tolerated by each insert component.",
        "zh": "区分树脂施工温度与组件工作温度，审核各嵌件元件能够承受的热量与压力。"
      }
    },
    {
      "title": {
        "en": "Material preparation",
        "zh": "控制物料准备"
      },
      "copy": {
        "en": "Follow the applicable TDS for storage, moisture control, surface condition and melt handling. Record grade and lot traceability.",
        "zh": "按适用TDS控制储存、含水、表面状态与熔料处理，并记录牌号和批次追溯。"
      }
    },
    {
      "title": {
        "en": "Tool and process window",
        "zh": "建立模具与工艺窗口"
      },
      "copy": {
        "en": "Review gates, vents, support, shut-off surfaces and minimum wall sections. Release molding parameters from trials with the real insert.",
        "zh": "审核浇口、排气、支撑、封胶面与最小壁厚；依据真实嵌件试模放行成型参数。"
      }
    },
    {
      "title": {
        "en": "Complete assembly tests",
        "zh": "验证完整组件"
      },
      "copy": {
        "en": "Agree electrical, retention, dimensional, sealing and environmental checks for the finished configuration. A resin property is not a complete assembly qualification.",
        "zh": "为最终配置约定电气、保持力、尺寸、密封与环境检查；树脂性能不能替代完整组件验证。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
