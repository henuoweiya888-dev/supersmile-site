{
  "version": 2,
  "category_id": "cable-assembly-05",
  "route": "/products/audio-cable-assembly",
  "title": {
    "en": "Models, Part Numbers & Sourcing",
    "zh": "型号料号与定制采购"
  },
  "kicker": {
    "en": "PART NUMBER / INTERFACE / MATERIAL",
    "zh": "型号 / 接口 / 材料"
  },
  "intro": {
    "en": "Find a cable model or material part number, then send it for a custom replacement or original-part sourcing review.",
    "zh": "按成品型号或材料料号查找，提交编号即可沟通兼容替代件制作或原厂件采购。"
  },
  "jump": {
    "en": "Find Models & Material Part Numbers",
    "zh": "查找型号与材料料号"
  },
  "search_label": {
    "en": "Find a model or part number",
    "zh": "查找型号或料号"
  },
  "search_placeholder": {
    "en": "Brand, model, part number or product type",
    "zh": "输入品牌、型号、料号或产品类型"
  },
  "clear": {
    "en": "Clear",
    "zh": "清空"
  },
  "empty": {
    "en": "No matching references. Try a brand, full part number or a listed alias.",
    "zh": "未找到匹配项，请尝试品牌、完整料号或已列出的别名。"
  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Finished cable and harness references for this interface or application.",
        "zh": "此接口或应用方向的成品电缆与线束参考。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Connector, wire and process-material references for project selection.",
        "zh": "供项目选型的连接器、线材与工艺材料参考。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Audio topology",
        "zh": "音频拓扑"
      },
      "copy": {
        "en": "Confirm balanced or unbalanced wiring, channel count and the actual source and load interfaces.",
        "zh": "确认平衡或非平衡接法、声道数及实际音源和负载接口。"
      }
    },
    {
      "title": {
        "en": "Contact assignment",
        "zh": "触点定义"
      },
      "copy": {
        "en": "Specify TRS/TRRS or speaker-contact mapping, ground allocation and any microphone/control circuit.",
        "zh": "明确TRS/TRRS或扬声器触点对应、地线分配及麦克风/控制电路。"
      }
    },
    {
      "title": {
        "en": "Noise control",
        "zh": "噪声控制"
      },
      "copy": {
        "en": "Select twisted pairs, shield coverage and shield termination for the installation and grounding arrangement.",
        "zh": "按安装环境与接地方式选择双绞线对、屏蔽覆盖及屏蔽端接。"
      }
    },
    {
      "title": {
        "en": "Load and conductor size",
        "zh": "负载与线规"
      },
      "copy": {
        "en": "Separate low-level signal leads from speaker-power cables when choosing gauge and contact ratings.",
        "zh": "选择线规与触点额定值时，区分小信号线与扬声器功率线。"
      }
    },
    {
      "title": {
        "en": "Mechanical routing",
        "zh": "机械走线"
      },
      "copy": {
        "en": "Confirm plug angle, splitter position, exposed length and the route behind the panel or enclosure.",
        "zh": "确认插头角度、分线点、外露长度及面板或机壳后的布线。"
      }
    },
    {
      "title": {
        "en": "Functional verification",
        "zh": "功能验证"
      },
      "copy": {
        "en": "Agree channel continuity, polarity and audio checks with the intended equipment.",
        "zh": "结合实际设备约定声道导通、极性与音频功能检验。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
      "en": "Discuss Custom Manufacturing & Sourcing",
      "zh": "咨询定制与采购"
    },
    "url": "/contact?category=cable-assembly-05&source=part-number-review"
  },
  "source_label": {
