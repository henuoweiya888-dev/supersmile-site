  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Insert and mating envelope",
        "zh": "嵌件与对插空间"
      },
      "copy": {
        "en": "Confirm connector part numbers, latch travel, keying and space that the mold must leave clear.",
        "zh": "确认连接器料号、锁扣行程、防呆及模具必须避让的对插空间。"
      }
    },
    {
      "title": {
        "en": "Jacket-to-resin interface",
        "zh": "护套与包胶界面"
      },
      "copy": {
        "en": "Select the mold resin with the actual cable jacket and insert materials; verify adhesion on assembled samples.",
        "zh": "结合真实线缆护套与嵌件材质选胶，并用成型样件验证结合效果。"
      }
    },
    {
      "title": {
        "en": "Cable exit and support",
        "zh": "出线与应力释放"
      },
      "copy": {
        "en": "Define exit angle, supported length, bend clearance and the cable pull direction at installation.",
        "zh": "定义出线角度、支撑长度、弯曲空间与安装后的受拉方向。"
      }
    },
    {
      "title": {
        "en": "Mold and thermal exposure",
        "zh": "模具与热暴露"
      },
      "copy": {
        "en": "Review gate location, insert positioning, molding pressure and thermal exposure against the connector limits.",
        "zh": "按连接器限制审核进胶位置、嵌件定位、成型压力与热暴露。"
      }
    },
    {
      "title": {
        "en": "Seal boundary",
        "zh": "密封边界"
      },
      "copy": {
        "en": "Specify the required sealed interfaces and test the completed assembly in its actual mating state.",
        "zh": "明确要求密封的界面，并在实际对插状态验证完整组件。"
      }
    },
    {
      "title": {
        "en": "Controlled first article",
        "zh": "首件确认"
      },
      "copy": {
        "en": "Approve molded dimensions, flash limits, pin mapping and electrical tests before releasing the tooling revision.",
        "zh": "放行模具版本前确认成型尺寸、飞边限值、针脚对应与电气测试。"
      }
    }
  ],
  "boundary": {
