  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "A transmission controller interprets sensor signals and drives the relevant actuators; it may be integrated into a module, attached to the transmission or housed separately. A harness therefore needs a controlled pin map and an explicit boundary between oil-wet, through-wall and vehicle-side environments. Matching connector shape alone does not establish signal identity, fluid compatibility or leak tightness.",
        "zh": "变速箱控制单元读取传感器信号并驱动相应执行器；它可能集成在模块中、安装于变速箱上，也可能独立布置。因此线束必须有受控针脚表，并明确油浸区、穿壳区和整车外侧环境的边界。接头外形相同不能证明信号身份、油液相容性或密封可靠性。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "For quotation, identify vehicle and transmission model, model year and variant, TCU or mechatronic reference, internal or external scope, connector part numbers and cavity views, solenoid and sensor assignments, operating voltage, route and clip datums, specified fluid and temperature exposure, drawings or an approved sample, quantities and the required inspection plan. Oil-wet or safety-related scope needs separate review.",
        "zh": "询价请提供车型、变速箱型号、年款与变型、TCU 或机电液模块料号、内部或外部供货范围、连接器料号与孔位视图、电磁阀和传感器回路、电压、走线与固定基准、指定油液和温度暴露、图纸或批准样品、数量及所需检验计划。油浸或安全相关范围须单独审核。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Approved inputs become a circuit matrix, connector BOM, branch drawing, material record and first-article inspection plan. Checks can include cavity and wire identity, terminal seating, locks, branch dimensions, connector mating and agreed electrical tests. Fluid resistance, seal integrity, controller behavior and vehicle shift performance require their own specified methods and acceptance criteria; continuity alone does not establish them.",
        "zh": "批准资料转化为回路矩阵、连接器物料表、分支图、材料记录与首件检验计划。可核对孔位与线号、端子入位、锁止、分支尺寸、对插及约定电气项目。耐油、密封、控制器行为和整车换挡性能均需各自规定试验方法与接收标准，不能由导通合格推导。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
