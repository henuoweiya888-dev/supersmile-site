  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Electrical layer",
        "zh": "明确电气接口"
      },
      "copy": {
        "en": "Specify TTL UART, RS232, RS422 or RS485 before choosing an endpoint. A similar connector does not establish compatible signal levels.",
        "zh": "先明确TTL UART、RS232、RS422或RS485，再选择端点；相似接头不能证明信号电平兼容。"
      }
    },
    {
      "title": {
        "en": "Signals and supply",
        "zh": "区分信号与供电"
      },
      "copy": {
        "en": "Define I/O voltage, VCC output or target supply, ground, handshake lines and pin mapping separately. Review the exact part datasheet.",
        "zh": "分别定义I/O电平、VCC输出或目标供电、接地、握手线与针脚表，并核对准确型号规格书。"
      }
    },
    {
      "title": {
        "en": "Host and drivers",
        "zh": "确认主机与驱动"
      },
      "copy": {
        "en": "Identify the host OS, VCP or D2XX workflow, application protocol and any MPSSE library requirements. A UART cable is not a substitute for every SPI or JTAG adapter.",
        "zh": "确认主机系统、VCP或D2XX路径、应用协议及MPSSE库要求；UART线不能替代所有SPI或JTAG适配器。"
      }
    },
    {
      "title": {
        "en": "Target connection",
        "zh": "定义设备端连接"
      },
      "copy": {
        "en": "Record connector keying, contact assignment, cable length, shield path, strain relief and any open-wire termination.",
        "zh": "记录接头防错、触点定义、线长、屏蔽路径、应力释放及裸线端接方式。"
      }
    },
    {
      "title": {
        "en": "Electronic configuration",
        "zh": "管理电子配置"
      },
      "copy": {
        "en": "Confirm the genuine conversion device, programmed identity and serial configuration with the customer. Record any authorized EEPROM changes.",
        "zh": "与客户确认转换器件来源、设备身份及串行配置，并记录获准的EEPROM变更。"
      }
    },
    {
      "title": {
        "en": "Active verification",
        "zh": "完成有源验证"
      },
      "copy": {
        "en": "Define enumeration, communication, loopback or target-function checks alongside continuity and visual inspection. Retain the released hardware and configuration revisions.",
        "zh": "除导通与外观检查外，定义枚举、通信、回环或目标设备功能检查，并保留获批硬件与配置版本。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
