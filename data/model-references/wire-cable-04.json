      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Category-specific material references; the final BOM follows the approved configuration.",
        "zh": "此类选型的材料参考；最终 BOM 以确认配置为准。"
      }
    }
  ],
  "checks_title": {
    "en": "Selection & Project Review",
    "zh": "选型与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Application Boundary",
        "zh": "应用边界"
      },
      "copy": {
        "en": "The exact CAN profile, physical layer, topology, termination, pair construction and validation scope must be identified together.",
        "zh": "准确 CAN 配置、物理层、拓扑、终端、线对结构与验证范围必须共同识别。"
      }
    },
    {
      "title": {
        "en": "Project Inputs",
        "zh": "项目输入"
      },
      "copy": {
        "en": "Provide device models, bit rates, topology, bus and stub lengths, termination locations, cable and connector specifications, environment and test requirements.",
        "zh": "请提供设备型号、速率、拓扑、主干与支线长度、终端位置、线缆和接口规范、环境与测试要求。"
      }
    },
    {
      "title": {
        "en": "Release Records",
        "zh": "放行依据"
      },
      "copy": {
        "en": "Release records the cable, pair and shield construction, connectors, pinout, topology, termination, lengths, process, traceability and agreed evidence.",
        "zh": "放行记录包含线缆、线对与屏蔽结构、接口、针脚、拓扑、终端、长度、工艺、追溯与约定证据。"
      }
    },
    {
      "title": {
        "en": "Interface Review",
        "zh": "接口审核"
      },
      "copy": {
        "en": "Confirm the exact mating interface, pin map, dimensions and installation orientation.",
        "zh": "确认准确对插接口、针脚对应、尺寸及安装方向。"
      }
    },
    {
      "title": {
        "en": "Sample Acceptance",
        "zh": "样品验收"
      },
      "copy": {
        "en": "Agree the sample configuration and electrical, mechanical or environmental checks required by the project.",
        "zh": "约定样品配置以及项目所需的电气、机械或环境检查。"
      }
    },
    {
      "title": {
        "en": "Change Control",
        "zh": "变更控制"
      },
      "copy": {
        "en": "Record changes to materials, drawings and process instructions before repeat manufacture.",
        "zh": "重复制造前记录材料、图纸与工艺说明的变更。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
