  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Equipment and contact boundary",
        "zh": "设备与接触边界"
      },
      "copy": {
        "en": "Confirm the equipment interface and whether any cable material contacts patients or requires a defined cleaning process.",
        "zh": "确认设备接口，以及线缆材料是否接触患者或需要特定清洁流程。"
      }
    },
    {
      "title": {
        "en": "Electrical function",
        "zh": "电气功能"
      },
      "copy": {
        "en": "Separate patient signals, power and controls; confirm the device-specific circuit and insulation requirements.",
        "zh": "区分患者信号、电源与控制，并确认设备专用电路和绝缘要求。"
      }
    },
    {
      "title": {
        "en": "Material grade selection",
        "zh": "材料牌号选择"
      },
      "copy": {
        "en": "Specify jacket and molded-part grades with the required material evidence; a supplier grade is not a finished-device approval.",
        "zh": "明确护套及成型件牌号和所需材料证据；供应商牌号不等于成品设备获批。"
      }
    },
    {
      "title": {
        "en": "Cleaning and sterilization",
        "zh": "清洁与灭菌"
      },
      "copy": {
        "en": "Name the cleaning agents or sterilization method and the intended number of cycles for assembly testing.",
        "zh": "列明清洁剂或灭菌方式及预期次数，以便验证完整组件。"
      }
    },
    {
      "title": {
        "en": "Handling and service",
        "zh": "操作与维修"
      },
      "copy": {
        "en": "Review flexing, connector retention, grip, service access and strain relief in the actual use position.",
        "zh": "按实际使用姿态审核弯折、接口保持力、握持、维修空间及应力释放。"
      }
    },
    {
      "title": {
        "en": "Controlled acceptance",
        "zh": "受控验收"
      },
      "copy": {
        "en": "Agree continuity, insulation, identification and traceability records under the customer’s equipment requirements.",
        "zh": "按客户设备要求约定导通、绝缘、标识及追溯记录。"
      }
    }
  ],
