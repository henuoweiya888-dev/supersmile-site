  "title": {
    "en": "Models, Part Numbers & Sourcing",
    "zh": "型号料号与定制采购"
  },
  "kicker": {
    "en": "PART NUMBER / INTERFACE / MATERIAL",
    "zh": "型号 / 接口 / 材料"
  },
  "intro": {
    "en": "Find a cable model or material part number, then send it for a custom replacement or original-part sourcing review.",
    "zh": "按成品型号或材料料号查找，提交编号即可沟通兼容替代件制作或原厂件采购。"
  },
  "jump": {
    "en": "Find Models & Material Part Numbers",
    "zh": "查找型号与材料料号"
  },
  "search_label": {
    "en": "Find a model or part number",
    "zh": "查找型号或料号"
  },
  "search_placeholder": {
    "en": "Brand, model, part number or product type",
    "zh": "输入品牌、型号、料号或产品类型"
  },
  "clear": {
    "en": "Clear",
    "zh": "清空"
  },
  "empty": {
    "en": "No matching references. Try a brand, full part number or a listed alias.",
    "zh": "未找到匹配项，请尝试品牌、完整料号或已列出的别名。"
  },
  "groups": [
    {
      "key": "products",
      "title": {
        "en": "Cable & Harness Models",
        "zh": "成品电缆与线束型号"
      },
      "intro": {
        "en": "Equipment interface cable references. Patient connections and regulated device requirements are reviewed separately.",
        "zh": "用于设备接口连接的成品参考；患者连接及受监管设备要求需单独审核。"
      }
    },
    {
      "key": "materials",
      "title": {
        "en": "Connector & Material Part Numbers",
        "zh": "连接器与材料料号"
      },
      "intro": {
        "en": "Connector, wire and process-material references for project selection.",
        "zh": "供项目选型的连接器、线材与工艺材料参考。"
      }
    }
  ],
  "checks_title": {
    "en": "Configuration & Project Review",
    "zh": "配置与项目确认"
  },
  "checks": [
    {
      "title": {
        "en": "Equipment and contact boundary",
        "zh": "设备与接触边界"
      },
      "copy": {
        "en": "Confirm the equipment interface and whether any cable material contacts patients or requires a defined cleaning process.",
        "zh": "确认设备接口，以及线缆材料是否接触患者或需要特定清洁流程。"
      }
    },
    {
      "title": {
        "en": "Electrical function",
        "zh": "电气功能"
      },
      "copy": {
        "en": "Separate patient signals, power and controls; confirm the device-specific circuit and insulation requirements.",
        "zh": "区分患者信号、电源与控制，并确认设备专用电路和绝缘要求。"
      }
    },
    {
      "title": {
        "en": "Material grade selection",
        "zh": "材料牌号选择"
      },
      "copy": {
        "en": "Specify jacket and molded-part grades with the required material evidence; a supplier grade is not a finished-device approval.",
        "zh": "明确护套及成型件牌号和所需材料证据；供应商牌号不等于成品设备获批。"
      }
    },
    {
      "title": {
        "en": "Cleaning and sterilization",
        "zh": "清洁与灭菌"
      },
      "copy": {
        "en": "Name the cleaning agents or sterilization method and the intended number of cycles for assembly testing.",
        "zh": "列明清洁剂或灭菌方式及预期次数，以便验证完整组件。"
      }
    },
    {
      "title": {
        "en": "Handling and service",
        "zh": "操作与维修"
      },
      "copy": {
        "en": "Review flexing, connector retention, grip, service access and strain relief in the actual use position.",
        "zh": "按实际使用姿态审核弯折、接口保持力、握持、维修空间及应力释放。"
      }
    },
    {
      "title": {
        "en": "Controlled acceptance",
        "zh": "受控验收"
      },
      "copy": {
        "en": "Agree continuity, insulation, identification and traceability records under the customer’s equipment requirements.",
        "zh": "按客户设备要求约定导通、绝缘、标识及追溯记录。"
      }
    }
  ],
  "boundary": {
    "en": "Send the part number, drawing or sample to confirm the replacement configuration and sourcing plan.",
    "zh": "请提供型号、图纸或样品，具体替代配置与原厂件采购方案按项目确认。"
  },
  "cta": {
    "text": {
      "en": "Send the model or part number to discuss your project.",
      "zh": "提交型号或料号，沟通您的定制与采购需求。"
    },
    "label": {
      "en": "Discuss Custom Manufacturing & Sourcing",
      "zh": "咨询定制与采购"
    },
    "url": "/contact?category=cable-assembly-13&source=part-number-review"
  },
  "source_label": {
